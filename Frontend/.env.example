# ========================================================
# SUCCESS BOOK HUB - FRONTEND ENVIRONMENT CONFIGURATION
# ========================================================

# Production Backend API URL
# If hosting Frontend and Backend on same domain (e.g. via reverse proxy or subpath):
# VITE_API_URL=https://yourdomain.com/api
#
# If hosting Backend on a subdomain (e.g. api.yourdomain.com):
# VITE_API_URL=https://api.yourdomain.com/api
#
# For Local Development:
VITE_API_URL=http://localhost:5000/api
