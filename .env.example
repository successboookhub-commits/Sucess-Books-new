# ========================================================
# SUCCESS BOOK HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# Base URLs
FRONTEND_URL=https://successbookhub.com
INTERNAL_API_URL=http://127.0.0.1:5000

# WhatsApp Business / Notification Number (Country code without +, e.g. 919876543210)
WHATSAPP_NUMBER=919876543210

# Admin Auth & Nodemailer Gmail SMTP Configuration
ADMIN_EMAIL=your_admin_email@domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_email@domain.com
SMTP_PASS=your_gmail_app_password
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Production MySQL Database Configuration (Hostinger hPanel / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u803044110_your_db_name
DB_USER=u803044110_your_db_user
DB_PASSWORD=your_secure_db_password

# Development Engine Override (Optional: set to true to force local SQLite in dev)
USE_SQLITE=false
