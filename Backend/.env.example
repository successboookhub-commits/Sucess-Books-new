# ========================================================
# SUCCESS BOOK HUB - BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
PORT=5000
NODE_ENV=production

# Frontend URL (For CORS allowed origins)
# In production on Hostinger: https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# WhatsApp Business / Notification Number (with country code, no +)
WHATSAPP_NUMBER=919876543210

# ========================================================
# HOSTINGER MySQL DATABASE CONFIGURATION (phpMyAdmin)
# ========================================================
# Hostinger MySQL Host (Usually 'localhost' or '127.0.0.1')
DB_HOST=localhost
DB_PORT=3306

# Hostinger Database Name (e.g., u123456789_successbooks)
DB_NAME=u123456789_successbooks

# Hostinger Database User (e.g., u123456789_dbuser)
DB_USER=u123456789_dbuser

# Hostinger Database Password
DB_PASSWORD=your_strong_mysql_password

# Note: If DB_HOST / DB_NAME are not set, the backend will automatically fallback to local SQLite.
